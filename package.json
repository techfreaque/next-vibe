  "bin": {
    "vibe": "./.dist/bin/vibe-runtime.js"
  },
  "files": [
    "check.config.ts",
    ".dist/**/*",
    "src/vibe/**/*"
  ],
  "type": "module",
  "main": "./.dist/bin/vibe-runtime.js",
  "exports": {
    ".": {
      "import": "./.dist/bin/vibe-runtime.js",
      "default": "./.dist/bin/vibe-runtime.js"
    },
    "./*": {
      "types": "./src/vibe/*",
      "import": "./src/vibe/*",
      "default": "./src/vibe/*"
    }
  },
  "scripts": {
    "postinstall": "node src/vibe/platforms/cli/bootstrap-vibe-runtime.mjs setup",
    "vibe": "vibe",
    "dev": "vibe dev",
    "build": "vibe build",
    "start": "vibe start",
    "test": "bun test --bail --isolate",
    "check": "vibe check",
    "lint": "echo redirecting to check && vibe check",
    "studio": "vibe studio",
    "typecheck": "echo redirecting to check && vibe check",
    "mcp:test": "bunx @modelcontextprotocol/inspector bun src/vibe/platforms/cli/vibe-runtime.ts mcp --verbose",
    "native": "expo start",
    "native:android": "expo run:android",
    "native:ios": "expo run:ios",
    "native:reset": "expo start --clear"
  },
