**/node_modules
/dist
/.dist*
/.next*
/.env
/.env.staging
/.npmrc
/.tanstack

# Generated files — regenerated by `vibe setup` (bun install postinstall) / `vibe gen`.
# Committed exceptions: recorded AI test fixtures (not regenerable) and
# hand-maintained scaffolding / "use custom" overrides in the app dirs.
/src/generated/*
!/src/generated/ai-fixtures
!/src/generated/app-native
/src/generated/app-native/*
!/src/generated/app-native/_layout.tsx
!/src/generated/app-native/global.css
!/src/generated/app-native/index.tsx
!/src/generated/app-native/nextjs-compat-wrapper.tsx
!/src/generated/app-native/\[locale\]
/src/generated/app-native/\[locale\]/*
!/src/generated/app-native/\[locale\]/nextjs-compat-wrapper.tsx
!/src/generated/app-native/\[locale\]/native-test
!/src/generated/app-tanstack
/src/generated/app-tanstack/*
!/src/generated/app-tanstack/client.tsx
!/src/generated/app-tanstack/nextjs-compat-wrapper.tsx
!/src/generated/app-tanstack/router.tsx
!/src/generated/app-tanstack/start.ts
!/src/generated/app-tanstack/routes
/src/generated/app-tanstack/routes/*
!/src/generated/app-tanstack/routes/__root.tsx
!/src/generated/app-tanstack/routes/index.tsx
/src/app-tanstack/routeTree.gen.ts

# system temporary files
/.tmp
/src/vibe/tooling/check/test-project/.tmp

# react native
/.expo

# vibe env decryption key
/.vibe.key

