# src/vibe/platforms/mcp/mcp.template.json, contain local paths)
/mcp.json
/.mcp.json
/.cursor/mcp.json
/.vscode/mcp.json
/src/vibe/tooling/check/test-project/.vscode
/src/vibe/tooling/check/test-project/.cursor
/src/vibe/tooling/check/test-project/.mcp.json

