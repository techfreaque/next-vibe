{
  "url": "https://openrouter.ai/api/v1/chat/completions",
  "method": "POST",
  "headers": {
    "authorization": "[redacted]",
    "content-type": "application/json",
    "http-referer": "https://unbottled.ai",
    "user-agent": "ai-sdk/openrouter/2.5.1 ai-sdk/provider-utils/4.0.1 runtime/bun/1.3.14",
    "x-openrouter-categories": "general-chat,roleplay,personal-agent",
    "x-title": "Unbottled AI"
  },
  "body": {
    "model": "moonshotai/kimi-k2",
    "messages": [
      {
        "role": "system",
        "content": "[Compacting request - summarize previous conversation history]"
      },
      {
        "role": "user",
        "content": "Please summarize the conversation history above concisely."
      }
    ],
    "stream": true,
    "temperature": 0.3,
    "max_tokens": 2000
  }
}
