{
  "mcpServers": {
    "hermes": {
      "command": "bun",
      "args": [
        "--preload",
        "{{PROJECT_PATH}}/src/app/api/[locale]/system/platforms/cli/runtime/env-preload.ts",
        "{{PROJECT_PATH}}/src/app/api/[locale]/system/platforms/cli/vibe-runtime.ts",
        "mcp",
        "--hermes"
      ],
      "env": {
        "NODE_ENV": "production",
        "PROJECT_ROOT": "{{PROJECT_PATH}}"
      }
    },
    "atlas": {
      "command": "bun",
      "args": [
        "--preload",
        "{{PROJECT_PATH}}/src/app/api/[locale]/system/platforms/cli/runtime/env-preload.ts",
        "{{PROJECT_PATH}}/src/app/api/[locale]/system/platforms/cli/vibe-runtime.ts",
        "mcp"
      ],
      "env": {
        "PROJECT_ROOT": "{{PROJECT_PATH}}"
      }
    }
  }
}
