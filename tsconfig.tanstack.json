{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "next-vibe/*": ["./src/app/api/[locale]/system/*"],
      "next-vibe-ui/*": [
        "./src/app/api/[locale]/system/ui/tanstack/*",
        "./src/app/api/[locale]/system/ui/web/*"
      ],
      "server-only": [
        "./src/app/api/[locale]/system/ui/tanstack/lib/server-only.ts"
      ]
    }
  },
  "include": ["src/generated/app-tanstack/**/*", "src/app/**/*"]
}
