# /etc/ha-failover/ha.env on Server 1 (current primary). Not secret.
HA_NODE=s1
HA_PEER=s2
HA_PEER_WG=10.88.0.2
HA_PEER_PUBLIC=179.198.214.41
HA_SELF_PUBLIC=72.61.156.49
HA_DEFAULT_ROLE=primary
HA_LOCAL_PG=prod-postgres
# What a fence stops + disables on this box (S2 promoted => S1 must not write).
HA_ALLOW_REMOTE_FENCE=1
HA_FENCE_CONTAINERS="next-vibe-app prod-postgres"
HA_CHECK_INTERVAL=10
HA_PEER_ALERT_AFTER=300
# WireGuard peer endpoints, preferred first (IPv6: the provider dropped IPv4
# UDP S1->S2 on 2026-11-13). The watchdog alternates when the handshake is stale.
HA_WG_ENDPOINTS="[2a02:4780:7e:844d::1]:51820 179.198.214.41:51820"
HA_WG_STALE_AFTER=300
