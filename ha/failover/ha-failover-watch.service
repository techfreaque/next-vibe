[Unit]
Description=unbottled HA watchdog (peer health, fencing, auto failover, alerts)
After=docker.service network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/ha-failover watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
