# /etc/ha-failover/secrets.env (chmod 600, root). NEVER commit real values.
# Alert mail (SMTPS 465), sent from the thea@unbottled.ai mailbox.
# Recipients: ONLY hi@ + thea@unbottled.ai, never a private address.
HA_MAIL_HOST=mail.a42.ch
HA_MAIL_USER=thea@unbottled.ai
HA_MAIL_PASSWORD=REPLACE_ME
HA_MAIL_FROM=thea@unbottled.ai
HA_MAIL_TO=hi@unbottled.ai,thea@unbottled.ai
# S2 only: hosttech DNS API token, used by `ha-failover promote` to repoint
# the apex/www A records while the domain is still delegated to hosttech.
HOSTTECH_DNS_KEY=REPLACE_ME
