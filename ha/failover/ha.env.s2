# /etc/ha-failover/ha.env on Server 2 (standby, failover target). Not secret.
HA_NODE=s2
HA_PEER=s1
HA_PEER_WG=10.88.0.1
HA_PEER_PUBLIC=72.61.156.49
HA_SELF_PUBLIC=179.198.214.41
HA_PEER_PG_PORT=5432
HA_DEFAULT_ROLE=standby
HA_LOCAL_PG=unbottled-pg-replica
HA_APP_DIR=/root/unbottled
HA_LOCAL_DB_HOST=pg-replica
HA_LOCAL_REDIS_URL=redis://unbottled-redis:6379
HA_LOCAL_S3_ENDPOINT=http://unbottled-minio:9000
HA_HOSTTECH_ZONE_ID=391416
HA_ALLOW_REMOTE_FENCE=0
# Automatic promotion: S1 unreachable on ALL paths for HA_FAILOVER_AFTER s,
# S2 online, external witness agrees, no hold. 0 = alert only.
HA_AUTO_FAILOVER=1
HA_FAILOVER_AFTER=180
HA_ALERT_AFTER=60
HA_CHECK_INTERVAL=15
# WireGuard peer endpoints, preferred first (IPv6: the provider dropped IPv4
# UDP S1->S2 on 2026-11-13). The watchdog alternates when the handshake is stale.
HA_WG_ENDPOINTS="[2a02:4780:41:1ae3::1]:51820 72.61.156.49:51820"
HA_WG_STALE_AFTER=300
