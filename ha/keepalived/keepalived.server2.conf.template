# keepalived — SERVER 2 (replica, lower priority / BACKUP). Install to
# /etc/keepalived/keepalived.conf. Render __PLACEHOLDERS__.
global_defs {
    router_id srv2
    enable_script_security
    script_user root
}

vrrp_script chk_app {
    script "/etc/keepalived/chk_app.sh"
    interval 3
    timeout 2
    weight -60
    fall 2
    rise 2
}

vrrp_instance VI_PUBLIC {
    state BACKUP
    interface __PUBLIC_IFACE__
    virtual_router_id 51
    priority 100
    advert_int 1
    authentication {
        auth_type PASS
        auth_pass __VRRP_PASS_PUBLIC__
    }
    virtual_ipaddress {
        __FLOATING_IP__
    }
    track_script { chk_app }
    notify_master "/etc/keepalived/floating-ip-attach.sh srv2"
}

vrrp_instance VI_DB {
    state BACKUP
    interface wg0
    virtual_router_id 52
    priority 100
    advert_int 1
    nopreempt
    authentication {
        auth_type PASS
        auth_pass __VRRP_PASS_DB__
    }
    virtual_ipaddress {
        10.88.0.10/24 dev wg0
    }
    track_script { chk_app }
    notify_master "/etc/keepalived/notify-pg.sh master"
    notify_backup "/etc/keepalived/notify-pg.sh backup"
    notify_fault  "/etc/keepalived/notify-pg.sh fault"
}
