# ===========================================================================
# Per-box LB — unbottled.ai served by THIS node's Caddy, load-balancing across
# the node's N LOCAL app replicas. One of these per node (identical on both);
# the self-hosted DNS edge (round-robin A) spreads traffic BETWEEN nodes, this
# Caddy block spreads it ACROSS the replicas ON a node, so all cores are used.
#
# Staged for cutover — NOT live yet. At cutover it REPLACES each node's current
# single-upstream `unbottled.ai { reverse_proxy next-vibe-app:3000 }` block.
#
# Upstreams are LOCAL replica container names on the shared `caddy_internal`
# docker network (NOT cross-WG — cross-node balancing is DNS's job, and keeps a
# node's traffic on its own cores + its own low-latency DB path):
#   replica 1 : unbottled-app:3000     ws unbottled-app:4000
#   replica 2 : unbottled-app-2:3000   ws unbottled-app-2:4000
#   …add -3/-4 lines as REPLICAS grows (deploy-ha.sh renders this list).
#
# Health check: GET /robots.txt must return 200. It is app-served + unauth +
# returns 200 only while the app is actually serving; during a rolling-deploy
# drain the container is `docker stop`ped so the port refuses → Caddy ejects it
# within fail_duration. (The app's /health endpoint needs auth → unusable as an
# anonymous probe; /robots.txt is the reliable liveness signal.)
# ===========================================================================
unbottled.ai {
	@ws path /ws*
	handle @ws {
		reverse_proxy unbottled-app:4000 unbottled-app-2:4000 {
			lb_policy least_conn
			health_uri /robots.txt
			health_port 3000
			health_interval 5s
			health_timeout 2s
			health_status 200
			fail_duration 10s
			max_fails 2
		}
	}

	handle {
		reverse_proxy unbottled-app:3000 unbottled-app-2:3000 {
			lb_policy least_conn
			# Active health check — ejects a draining/dead replica fast.
			health_uri /robots.txt
			health_interval 5s
			health_timeout 2s
			health_status 200
			# Passive ejection on connection errors.
			fail_duration 10s
			max_fails 2
			# Connection draining: finish in-flight requests on a replica that
			# is being removed (Caddy stops NEW requests to an unhealthy
			# upstream but does not cut active ones).
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}
}

www.unbottled.ai {
	@all path /*
	redir @all https://unbottled.ai{uri} 308
}
