# ===================== unbottled.ai HA (S1) =====================
# Canonical copy of the unbottled section of Server 1's /caddy/Caddyfile
# (caddy:2 container `caddy-caddy-1`, /caddy/data mounted at /data). The rest
# of that file (a42.ch sites) is not unbottled's. Apply: paste over the
# section only after deploying the committed admission code and passing
# `bash scripts/ha-edge-canary.sh --activation` on both running images. Then
#   docker exec caddy-caddy-1 caddy validate --config /etc/caddy/Caddyfile
#   docker exec caddy-caddy-1 caddy reload --config /etc/caddy/Caddyfile
# Server 2 carries the mirror image as labels (docker-compose.s2-edge.yml).
#
# Both local listeners bind loopback inside Caddy. The remote lane uses
# verified HTTPS to the peer's public IP and can survive a WireGuard outage.
http://:19381 {
	import /data/ha-routing/origin.caddy next-vibe-app:3000 next-vibe-app:3000 next-vibe-app:3099 disabled
}
http://:19382 {
	import /data/ha-routing/peer.caddy 179.198.214.41
}
# ACME HTTP-01 across the two-box edge: Let's Encrypt may reach EITHER box for
# a name both boxes serve. Caddy answers its own tokens before any route runs;
# a token it does not know is forwarded once to the peer (loop-guarded by the
# X-HA-Acme-Fwd header). Everything else on :80 redirects to https.
(unbottled_http_edge) {
	@acme_to_peer {
		path /.well-known/acme-challenge/*
		not header X-HA-Acme-Fwd *
	}
	handle @acme_to_peer {
		reverse_proxy 10.88.0.2:80 {
			header_up Host {host}
			header_up X-HA-Acme-Fwd 1
		}
	}
	handle /.well-known/acme-challenge/* {
		respond 404
	}
	handle {
		redir https://{host}{uri} 308
	}
}

http://unbottled.ai, http://www.unbottled.ai {
	import unbottled_http_edge
}

unbottled.ai {
	handle_errors 502 503 504 {
		import /data/ha-routing/unavailable.caddy
	}
	# Mark responses that reached this edge, including errors generated here.
	header +Server-Timing "vibe-edge;desc=\"s1\", vibe-edge-request;desc=\"{http.request.uuid}\""
	# Keep a status and timestamp even when the client sees no response headers.
	log unbottled_failures {
		level ERROR
		format filter {
			wrap json
			fields {
				request delete
				resp_headers delete
				user_id delete
			}
		}
	}
	@meta_crawler header_regexp User-Agent (?i)facebookexternalhit|meta-externalagent|meta-externalfetcher|meta-webindexer
	log_append @meta_crawler automation meta-crawler
	@next_asset path /_next/*
	log_append @next_asset surface next-asset
	@next_bundle path_regexp ^/_next/static/chunks/[a-zA-Z0-9_./~-]+\.(js|css)$
	log_append @next_bundle asset_path {http.request.orig_uri.path}
	# Record only the public directory badges shipped with the application.
	@public_badge path_regexp ^/images/badges/((dang|postmake|toolpilot)-(dark|light)\.png|(aitoolscapital|bestekitools)-(dark|light)\.svg|opensourcealternatives\.svg|whatsthebigdata\.jpg)$
	log_append @public_badge asset_path {http.request.orig_uri.path}
	@app_api path /api/*
	log_append @app_api surface api
	@realtime path /ws*
	log_append @realtime surface websocket
	log_append edge s1
	log_append edge_request_id {http.request.uuid}
	log_append upstream {rp.upstream.host}
	log_append upstream_header_wait_ms {rp.upstream.latency_ms}
	log_append upstream_duration_ms {rp.upstream.duration_ms}
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	import /data/ha-routing/ingress.caddy next-vibe-app:3000 179.198.214.41 s1
}

www.unbottled.ai {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}
	@all path /*
	redir @all https://unbottled.ai{uri} 308
}

www.bucksflux.com {
	@all path /*
	redir @all https://bucksflux.com{uri} 308
}

bucksflux.com {
	handle_errors 502 503 504 {
		import /data/ha-routing/unavailable.caddy
	}
	@keep path_regexp ^(/[^/]+/track|/[^/]+/story/newsletter/unsubscribe|/api/|/_next/)
	handle @keep {
		import /data/ha-routing/ingress.caddy next-vibe-app:3000 179.198.214.41 s1
	}
	handle {
		redir https://unbottled.ai{uri} 302
	}
}
