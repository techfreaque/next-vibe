global
    maxconn 2000
    log stdout format raw local0

defaults
    mode tcp
    timeout connect 3s
    timeout client 1h
    timeout server 1h
    retries 2
    log global

# The app connects here. HAProxy sends each Redis a `PING` + an `info replication`
# check and only the node that reports `role:master` passes the `tcp-check expect
# string role:master`, so writes always land on the live master. On failover the
# former replica (now master) starts passing the check and traffic shifts, no app
# change. (requirepass: the check authenticates first.)
frontend redis_front
    bind 0.0.0.0:6379
    default_backend redis_back

backend redis_back
    option tcp-check
    tcp-check connect
    tcp-check send AUTH\ __REDIS_PASSWORD__\r\n
    tcp-check expect string +OK
    tcp-check send PING\r\n
    tcp-check expect string +PONG
    tcp-check send info\ replication\r\n
    tcp-check expect string role:master
    tcp-check send QUIT\r\n
    tcp-check expect string +OK
    server redis1 10.88.0.1:6379 check inter 2s fall 2 rise 2
    server redis2 10.88.0.2:6379 check inter 2s fall 2 rise 2 backup
