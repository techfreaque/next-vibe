{
  "key": "unbottled-ai",
  "name": { "value": "Unbottled AI" },
  "description": { "value": "Control your Corvina installation through AI chat. Manage devices, users, data, and automations using natural language." },
  "type": "APP",
  "status": "ACTIVE",
  "baseUrl": "https://bath-evidence-upward.ngrok-free.dev",
  "apiVersion": "1.0.0",
  "authentication": {
    "type": "JWT"
  },
  "enableDeviceAccess": true,
  "trustedOrigins": [
    "https://corvina.cloud",
    "https://*.corvina.cloud"
  ],
  "hooks": {
    "globalPage": {
      "id": "unbottled-ai-globalPage",
      "title": { "value": "AI Chat" },
      "url": "/",
      "iconUrl": "/images/corvina-icon.svg"
    },
    "navigationDrawerPages": [
      {
        "title": { "value": "AI Chat" },
        "url": "/",
        "iconUrl": "/images/corvina-icon.svg"
      }
    ]
  },
  "scopes": {
    "userImpersonation": true,
    "devices": [
      {
        "deviceGroups": ["*"],
        "generalPermission": "REGULAR_USER",
        "modelPermissions": ["**"]
      }
    ]
  },
  "lifecycle": {
    "installed": "/api/corvina/lifecycle/installed",
    "uninstalled": "/api/corvina/lifecycle/uninstalled"
  },
  "vendor": {
    "name": "Unbottled AI",
    "website": "https://unbottled.ai",
    "email": "contact@unbottled.ai"
  },
  "coverImageUrl": "/images/unbottled-icon.png",
  "images": [
    { "url": "/images/unbottled-icon.png" }
  ]
}
