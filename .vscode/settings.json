{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "oxc.trace.server": "verbose",
  "oxc.enable": true,
  "oxc.lint.run": "onType",
  "oxc.configPath": ".tmp/.oxlintrc.json",
  "oxc.fmt.configPath": ".tmp/.oxfmtrc.json",
  "oxc.typeAware": true,
  "oxc.fixKind": "safe_fix",
  "prettier.enable": true,
  "prettier.requireConfig": true,
  "typescript.validate.enable": true,
  "typescript.suggest.autoImports": true,
  "typescript.preferences.preferTypeOnlyAutoImports": true,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode",
    "editor.formatOnSave": true
  },
  "files.eol": "\n",
  "files.exclude": {},
  "search.exclude": {
    "**/node_modules": true,
    "**/tsconfig.tsbuildinfo": true,
    "**/*.tmp": true,
    "**/*.next": true,
    "public/vibe-frame/**": true,
    "src/generated/**": true,
    ".tmp/**": true,
    ".tanstack/**": true,
    "**/testing/fixtures/**": true
  },
  "terminal.integrated.defaultProfile.linux": "Vibe Guard",
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "typescript.native-preview.tsdk": "node_modules\\@typescript\\native-preview",
  "oxc.fmt.experimental": true,
  "js/ts.experimental.useTsgo": true
}